{
  "name": "ai-watch-india",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "package:registry": "python scripts/build_registry.py",
    "package:governance": "python scripts/build_governance.py",
    "package:implementation": "python scripts/build_deployment_evidence.py",
    "package:data": "python scripts/build_context.py && python scripts/build_public_services.py && node scripts/package-briefs.mjs && node scripts/package-service-study.mjs && node scripts/package-data-room.mjs && python scripts/package_archive.py"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "diff": "^8.0.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.1.0",
    "wouter": "^3.7.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.3"
  }
}
